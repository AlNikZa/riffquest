<!DOCTYPE html>
<html lang="en">
  <!-- Include common head partial (meta tags, title, CSS links, etc.) -->
  <%- include('partials/head') %>

  <body class="d-flex flex-column min-vh-100">
    <!-- Include navbar partial -->
    <%- include('partials/navbar') %>

    <!-- Main page header -->
    <h1 class="text-center mt-5">Riff Quest</h1>
    <h2 class="text-secondary text-center fs-5 mb-5">
      Every song has its own riff
    </h2>
    <!-- Call to action: log in with Spotify -->
    <% if (!isLoggedIn) { %>
    <div class="text-center mb-5">
      <h3 class="text-secondary mb-3 fs-5">
        For full experience, log in with your Spotify account
      </h3>
      <a href="/login" class="btn btn-success btn-lg mb-2 spotify-login-btn">
        Log in with Spotify
      </a>
      <div class="fs-6 text-secondary">
        Don't have a Spotify account?
        <a
          href="https://www.spotify.com/signup/"
          target="_blank"
          class="text-success"
        >
          Create one
        </a>
      </div>
    </div>
    <% } %>

    <!-- Artist search form -->
    <form method="get" id="artist-form" autocomplete="off">
      <!-- Container for input + buttons; responsive layout -->
      <div class="w-75 mx-auto d-flex flex-column flex-md-row">
        <!-- Text input for artist name -->
        <!-- <div class="form-group"> -->
        <input
          id="artist-input"
          type="text"
          name="artist"
          class="form-control mb-2 mb-md-0 me-md-2"
          placeholder="Enter artist name…"
          list="suggestions"
          required
        />
        <datalist id="suggestions"></datalist>

        <!-- Button to view all albums of the artist -->
        <button
          type="submit"
          class="btn btn-success mb-2 mb-md-0 me-md-2 text-nowrap"
          formaction="/artists/albums"
        >
          View all albums
        </button>

        <!-- Button to view top tracks of the artist -->
        <button
          type="submit"
          class="btn btn-success mb-2 mb-md-0 me-md-2 text-nowrap"
          formaction="/artists/top-tracks"
        >
          View top tracks
        </button>

        <!-- Button to view detailed artist profile -->
        <button
          type="submit"
          class="btn btn-success mb-2 mb-md-0 me-md-2 text-nowrap"
          formaction="/artists/profile"
        >
          View artist details
        </button>
      </div>
    </form>

    <!-- Include Bootstrap navbar -->
    <%- include('partials/footer') %>

    <!-- Cookie notice -->
    <div
      id="cookie-banner"
      class="fixed-bottom bg-dark text-white py-2 px-3 d-flex justify-content-between align-items-center"
    >
      <span>
        We use cookies to keep you logged in and make the app work properly. We
        don’t collect any personal info.

        <a
          id="learn-more"
          href="/cookie-policy"
          class="text-success text-decoration-underline ms-1"
        >
          Learn more
        </a>
      </span>
      <button
        id="cookie-accept-btn"
        type="button"
        class="btn btn-sm btn-light ms-2"
      >
        Got it
      </button>
    </div>

    <!-- Include Bootstrap JS + dependencies -->
    <%- include('partials/bootstrapScriptTag') %>

    <!-- Include Bootstrap modals (if any) -->
    <%- include('partials/bootstrapModals') %>

    <!-- Custom JavaScript for handling modal forms -->
    <script nonce="<%= nonce %>" src="/formModals.js"></script>
    <script nonce="<%= nonce %>" src="/autocomplete.js"></script>
    <script nonce="<%= nonce %>" src="/authModals.js"></script>

    <!-- Custom JavaScript for handling the cookie banner -->
    <script nonce="<%= nonce %>">
      // Check if the user has already acknowledged the cookie notification
      if (localStorage.getItem('cookieNotificationRead') === 'true') {
        // If they have, immediately remove the banner from the DOM
        document.getElementById('cookie-banner').remove();
      }

      document.addEventListener('DOMContentLoaded', () => {
        // Get references to the banner and the two buttons
        const banner = document.getElementById('cookie-banner');
        const gotIt = document.getElementById('cookie-accept-btn');
        const learnMore = document.getElementById('learn-more');

        // Make sure all elements exist before continuing
        if (!banner || !gotIt || !learnMore)
          return console.error('Cookie banner or button not found!');

        // Only show the banner if it hasn't been acknowledged and the user is on the homepage
        if (
          !localStorage.getItem('cookieNotificationRead') &&
          window.location.pathname === '/'
        ) {
          banner.style.display = 'flex';
        }

        // Add click event listeners to both buttons
        [gotIt, learnMore].forEach((btn) => {
          btn.addEventListener('click', () => {
            // When either button is clicked, mark the banner as read in localStorage
            localStorage.setItem('cookieNotificationRead', 'true');
            // Remove the banner from the DOM
            banner.remove();
          });
        });
      });
    </script>
  </body>
</html>
