<!-- Modal for Artist Actions -->
<!-- Container for the modal with unique ID and accessibility attributes -->
<div
  class="modal fade"
  id="artistModal"
  tabindex="-1"
  aria-labelledby="choiceModalLabel"
  aria-hidden="true"
>
  <!-- Modal dialog wrapper -->
  <div class="modal-dialog">
    <div class="modal-content">
      <!-- Modal header: contains the title and close button -->
      <div class="modal-header">
        <h5 class="modal-title" id="choiceModalLabel">Choose an action</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>

      <!-- Modal body: content will be dynamically injected here -->
      <div class="modal-body" id="choiceModalBody"></div>

      <!-- Modal footer: action buttons for artist options -->
      <div class="modal-footer">
        <button type="button" class="btn btn-success" id="viewAlbumsBtn">
          View all albums
        </button>
        <button type="button" class="btn btn-success" id="viewTracksBtn">
          View top tracks
        </button>
        <button type="button" class="btn btn-success" id="viewInfoBtn">
          View artist details
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal for Login Confirmation -->
<% if (typeof justLoggedIn !== 'undefined' && justLoggedIn) { %>
<div
  class="modal fade"
  id="loginModal"
  tabindex="-1"
  aria-labelledby="loginModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <!-- Modal header -->
      <div class="modal-header">
        <h5 class="modal-title" id="loginModalLabel">Welcome to RiffQuest</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        Logged in as <strong><%=username %></strong><br />
        You're now connected to your Spotify account.
      </div>

      <!-- Modal footer -->
      <div class="modal-footer">
        <a
          id="loginContinue"
          href="#"
          class="btn btn-success"
          data-bs-dismiss="modal"
          >Continue</a
        >
        <a href="/logout" class="btn btn-secondary">Log out</a>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Modal for Logout Confirmation -->
<div
  class="modal fade"
  id="logoutModal"
  tabindex="-1"
  aria-labelledby="logoutModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-light">
      <!-- Modal header -->
      <div class="modal-header border-secondary">
        <h5 class="modal-title" id="logoutModalLabel">Confirm Sign Out</h5>
        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">Are you sure you want to sign out?</div>

      <!-- Modal footer -->
      <div class="modal-footer border-secondary">
        <button
          id="logoutNo"
          type="button"
          class="btn btn-secondary"
          data-bs-dismiss="modal"
        >
          No
        </button>
        <button type="button" id="confirmLogout" class="btn btn-danger">
          Yes, log out
        </button>
      </div>
    </div>
  </div>
</div>
