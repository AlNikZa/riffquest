<!-- views/partials/footer.ejs -->

<footer class="mt-auto bg-light text-center py-2">
  <hr class="w-75 mx-auto" />

  <p
    class="mb-0 text-body-secondary small d-flex flex-column flex-md-row justify-content-center align-items-center gap-3 flex-wrap"
  >
    <span class="d-flex align-items-center gap-2 order-1 order-md-0">
      <span>© <%= new Date().getFullYear() %></span>
      <a
        href="/"
        rel="noopener noreferrer"
        class="d-flex align-items-center gap-1 text-decoration-none text-secondary"
        aria-label="RiffQuest homepage"
      >
        <img src="/logo.png" alt="RiffQuest Logo" width="30" height="30" />
        <span class="text-success">RiffQuest</span>
      </a>
    </span>

    <span class="d-none d-md-inline">•</span>

    <span class="d-flex align-items-center order-2">
      <span>Content & artwork from</span>
      <a
        href="https://www.musicbrainz.org"
        target="_blank"
        rel="noopener noreferrer"
        class="d-flex align-items-center text-decoration-none"
        aria-label="MusicBrainz website"
      >
        <img
          class="ms-2"
          src="/MusicBrainzLogo.svg"
          alt="MusicBrainz"
          height="15"
        />
      </a>

      <span class="mx-2 text-muted">&</span>

      <a href="https://www.last.fm" target="_blank" rel="noopener noreferrer" class="opacity-75 hover-opacity-100 transition-sm">
        <img src="/lastfmLogo.svg" alt="Last.fm" height="15" /> 
      </a>

      <span class="mx-2 text-muted">&</span>
      
      <a href="https://fanart.tv/" target="_blank" rel="noopener noreferrer" class="opacity-75 hover-opacity-100 transition-sm">
        <img src="/fanartTvLogo.svg" alt="Fanat.tv" height="15" /> 
      </a>
      

    </span>
  </p>
</footer>
