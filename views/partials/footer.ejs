<!-- views/partials/footer.ejs -->

<footer class="mt-auto bg-light text-center py-2">
  <hr class="w-75 mx-auto" />

  <p
  class="mb-0 text-body-secondary small d-flex flex-column flex-md-row justify-content-center align-items-center gap-2 gap-md-3 text-center"
>
  <span class="d-flex align-items-center gap-2">
    <span>© <%= new Date().getFullYear() %></span>
    <a
      href="/"
      rel="noopener noreferrer"
      class="d-flex align-items-center gap-1 text-decoration-none text-secondary"
      aria-label="RiffQuest homepage"
    >
      <img src="/logo.png" alt="RiffQuest Logo" width="30" height="30" />
      <span class="text-success">RiffQuest</span>
    </a>

     <span class="d-none d-md-inline">•</span>
  </span>

  <span class="d-flex flex-column flex-md-row align-items-center gap-1 gap-md-2">
    
    <span>Content & artwork from</span>

    <span class="d-flex align-items-center gap-2 flex-wrap justify-content-center">
      <a href="https://www.musicbrainz.org" target="_blank" rel="noopener noreferrer">
        <img src="/MusicBrainzLogo.svg" alt="MusicBrainz" height="15" />
      </a>

      <span class="text-muted">&</span>

      <a href="https://www.last.fm" target="_blank" rel="noopener noreferrer">
        <img src="/lastfmLogo.svg" alt="Last.fm" height="15" />
      </a>

      <span class="text-muted">&</span>

      <a href="https://fanart.tv/" target="_blank" rel="noopener noreferrer">
        <img src="/fanartTvLogo.svg" alt="Fanart.tv" height="15" />
      </a>
    </span>

  </span>
</p>


</footer>
