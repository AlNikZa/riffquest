<!-- views/partials/navbar.ejs -->

<nav class="navbar navbar-expand-lg bg-success navbar-dark fixed-top">
  <div class="container-fluid">
    <!-- Brand/logo -->
    <a class="navbar-brand text-white" href="/">Riff Quest</a>

    <!-- Navbar toggler for mobile view -->
    <button
      class="navbar-toggler collapsed"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <i class="bi bi-arrow-bar-down text-white"></i>
    </button>

    <!-- Collapsible content -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <!-- Left side: Artist form -->
      <form
        id="artist-navbar-form"
        class="d-flex align-items-center"
        action="/artists/redirect"
        method="get"
        autocomplete="off"
      >
        <!-- CSRF token for JS POST requests -->
        <script nonce="<%= nonce %>">
          window.csrfToken =
            '<% if (typeof csrfToken !== "undefined") { %><%= csrfToken %><% } %>';
        </script>

        <input
          id="artist-navbar-input"
          class="form-control me-2 w-50"
          type="text"
          name="artist"
          placeholder="Enter artist name..."
          aria-label="Artist"
          list="navbar-suggestions"
          required
        />

        <datalist id="navbar-suggestions"></datalist>

        <div class="dropdown me-2">
          <button
            class="btn btn-success dropdown-toggle"
            type="button"
            id="artistDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            Artist action
          </button>
          <ul class="dropdown-menu" aria-labelledby="artistDropdown">
            <li>
              <button
                class="dropdown-item"
                type="submit"
                formaction="/artists/albums"
              >
                All albums
              </button>
            </li>
            <li>
              <button
                class="dropdown-item"
                type="submit"
                formaction="/artists/top-tracks"
              >
                Top tracks
              </button>
            </li>
            <li>
              <button
                class="dropdown-item"
                type="submit"
                formaction="/artists/profile"
              >
                Artist details
              </button>
            </li>
          </ul>
        </div>
      </form>

      <!-- Right side: Spotify login CTA -->
      <% if (!isLoggedIn) { %>
      <div class="d-flex ms-auto align-items-center">
        <a
          href="/auth/login"
          class="btn btn-outline-light mt-2 mt-lg-0 spotify-login-btn"
        >
          Log in with Spotify
        </a>
      </div>
      <% } else { %>
      <div class="d-flex ms-auto align-items-center">
        <a href="#" class="btn btn-outline-light mt-2 mt-lg-0 mx-2">
          <%= username %> <% if (userImg) { %>
          <img src="<%=userImg%>" id="user-navbar-img" alt="" srcset="" />
          <% } %>
        </a>
        <form action="/auth/logout" method="POST" class="d-inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button
            type="submit"
            class="btn btn-outline-light mt-2 mt-lg-0 spotify-logout-btn"
          >
            Log out
          </button>
        </form>
      </div>
      <% } %>
    </div>
  </div>
</nav>
