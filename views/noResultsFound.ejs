<!-- views/noResultsFound.ejs -->

<!DOCTYPE html>
<html lang="en">
  <!-- Include head partial (meta tags, CSS, etc.) -->
  <%- include('partials/head') %>

  <body class="d-flex flex-column min-vh-100">
    <!-- Include navbar partial -->
    <%- include('partials/navbar') %>

    <!-- Page header showing the error title dynamically -->
    <h1 class="text-center text-warning mt-5">404 Error</h1>
    <h2 class="text-center text-muted fs-5">
      <%= message || 'Page not found.' %>
    </h2>
    <!-- Informational message about no results found -->
    <div class="text-center fs-5 mb-5 mx-5 px-5">
      <% if (typeof artist !== 'undefined' && artist || typeof album !==
      'undefined' && album || typeof track !== 'undefined' && track) { %> No
      results found for <% let hasPrevious = false; %> <% if (typeof artist !==
      'undefined' && artist) { %> artist "<span class="text-warning"
        ><%= artist %></span
      >" <% hasPrevious = true; %> <% } %> <% if (typeof album !== 'undefined'
      && album) { %> <% if (hasPrevious) { %>, <% } %>album "<span
        class="text-warning"
        ><%= album %></span
      >" <% hasPrevious = true; %> <% } %> <% if (typeof track !== 'undefined'
      && track) { %> <% if (hasPrevious) { %>, <% } %>track "<span
        class="text-warning"
        ><%= track %></span
      >" <% hasPrevious = true; %> <% } %>.

      <br />
      Please check the spelling or try different search terms. <% } %>
    </div>
    <!-- Back to home button -->
    <div class="d-flex justify-content-center my-5">
      <a href="/" class="btn btn-outline-success">Go back to Home</a>
    </div>

    <!-- Include Bootstrap navbar -->
    <%- include('partials/footer') %>

    <!-- Include Bootstrap JS + dependencies -->
    <%- include('partials/bootstrapScriptTag') %>

    <!-- Include Bootstrap modals (if any) -->
    <%- include('partials/bootstrapModals') %>

    <!-- Custom JavaScript for handling modal forms -->
    <script nonce="<%= nonce %>" src="/formModals.js"></script>
    <script nonce="<%= nonce %>" src="/autocomplete.js"></script>
    <script nonce="<%= nonce %>" src="/authModals.js"></script>
  </body>
</html>
