<!-- views/noResultsFound.ejs -->

<!DOCTYPE html>
<html lang="en">
  <!-- Include head partial (meta tags, CSS, etc.) -->
  <%- include('partials/head') %>

  <body class="d-flex flex-column min-vh-100">
    <!-- Include navbar partial -->
    <%- include('partials/navbar') %>

    <!-- Page header showing the error title dynamically -->
    <h1 class="text-center text-warning mt-5">404 Error</h1>
    <h2 class="text-center fs-5">
      <%= message || 'Page not found.' %>
    </h2>
    

    <!-- Display validation or other detailed error messages (if any exist) -->
    <%- include('partials/displayErrors') %>

    <!-- Back to home button -->
    <div class="d-flex justify-content-center my-5">
      <a href="/" class="btn btn-outline-success">Go back to Home</a>
    </div>

    <!-- Include Bootstrap navbar -->
    <%- include('partials/footer') %>

    <!-- Include Bootstrap JS + dependencies -->
    <%- include('partials/bootstrapScriptTag') %>

    <!-- Include Bootstrap modals (if any) -->
    <%- include('partials/bootstrapModals') %>

    <!-- Custom JavaScript for handling modal forms -->
    <script nonce="<%= nonce %>" src="/formModals.js"></script>
    <script nonce="<%= nonce %>" src="/autocomplete.js"></script>
    <script nonce="<%= nonce %>" src="/authModals.js"></script>
  </body>
</html>
