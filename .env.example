# .env.example

# ================== Spotify API Credentials ==================
CLIENT_ID=your_spotify_client_id_here
CLIENT_SECRET=your_spotify_client_secret_here
# =============================================================

# ================== MongoDB Atlas Configuration ==================
MONGO_USER=your_mongo_username_here
MONGO_PASS=your_mongo_password_here
MONGO_DB=your_database_name_here
MONGO_CLUSTER=your_cluster_name_here
MONGO_HOST=your_cluster_host_here
# =================================================================

# ================== Spotify OAuth Redirect URIs ==================
REDIRECT_URI_DEV=http://127.0.0.1:3000/callback
REDIRECT_URI_PROD=https://your-production-domain.com/callback
# =================================================================

# ================== Application Base URLs ==================
BASE_URL_DEV=http://127.0.0.1:3000
BASE_URL_PROD=https://your-production-domain.com
# ===========================================================

SESSION_SECRET=your_session_secret_here
ENCRYPTION_KEY=your_encryption_key_here

ADMIN_PASSWORD=SuperSecretAdminPassword123! 
